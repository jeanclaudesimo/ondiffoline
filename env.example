# MariaDB Konfiguration für Ondiffoline mit Dokploy
# Kopieren Sie diese Datei zu .env.local und passen Sie die Werte an

# Datenbankverbindung (Dokploy MariaDB)
DB_HOST=your-mariadb-service-name.dokploy.internal
DB_USER=ondiffoline_user
DB_PASSWORD=your_secure_password_here
DB_NAME=db_name
DB_PORT=3306

# Alternative: Externe MariaDB-Verbindung
# DB_HOST=your-server-ip
# DB_USER=ondiffoline_user
# DB_PASSWORD=your_secure_password_here
# DB_NAME=ondiffoline
# DB_PORT=3306

# Optional: Admin-Benutzer für die Verwaltung
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ondiffoline.de

# Portal API Integration (für Gallery, Reviews, etc.)
NEXT_PUBLIC_PORTAL_API_URL=https://portal.digitalssolutions.de
NEXT_PUBLIC_PORTAL_TENANT_KEY=your_tenant_api_key_here
NEXT_PUBLIC_GALLERY_SLUG=arbeit-im-bild
